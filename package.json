{
  "name": "new-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "gen": "turbo gen",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:ci": "oxlint . --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "check-types": "turbo run check-types",
    "syncpack": "syncpack lint",
    "prepare": "husky || true",
    "knip": "knip",
    "boundaries": "turbo boundaries",
    "commit": "cz"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@turbo/gen": "^2.10.9",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "inquirer": "^9.3.7",
    "knip": "^6.32.0",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "syncpack": "^15.3.2",
    "turbo": "^2.10.9",
    "vitest": "^4.1.10"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.16.0"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
