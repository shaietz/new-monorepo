{
  "name": "new-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:ci": "oxlint . --deny-warnings",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "syncpack": "syncpack lint",
    "prepare": "husky",
    "knip": "knip",
    "boundaries": "turbo boundaries"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "knip": "^6.32.0",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "syncpack": "^15.3.2",
    "turbo": "^2.10.8",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.16.0"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
