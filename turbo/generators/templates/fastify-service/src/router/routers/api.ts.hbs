import { z } from 'zod';
import { publicProcedure, router } from '@repo/{{ dashCase name }}-api';

export const apiRouter = router({
  hello: publicProcedure
    .input(z.object({ username: z.string().nullish() }).nullish())
    .query(({ input }) => {
      return {
        text: `hello ${input?.username ?? 'world'}`,
      };
    }),
});