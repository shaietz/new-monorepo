import fastifyRedis from "@fastify/redis";
import fp from "fastify-plugin";
import type { FastifyRedisPluginOptions } from "@fastify/redis";

/**
 * The pre-built-client half of `@fastify/redis`'s options union. `Extract` rather than an index
 * access because the other half has no `client` property at all.
 */
export type RedisClient = Extract<FastifyRedisPluginOptions, { client: unknown }>["client"];

export interface RedisPluginOptions {
  /** A stand-in client, so a test suite needs no Redis. */
  readonly client?: RedisClient | undefined;
}

export function redisOptions(
  config: { REDIS_URL: string },
  client?: RedisClient,
): FastifyRedisPluginOptions {
  // An injected client's lifetime belongs to whoever built it, so don't close it on shutdown.
  if (client) return { client, closeClient: false };

  // Without this ioredis queues commands while the connection is down instead of rejecting them,
  // and a /readyz request would hang rather than report the outage.
  return { url: config.REDIS_URL, enableOfflineQueue: false };
}

/** @see {@link https://github.com/fastify/fastify-redis} */
export default fp<RedisPluginOptions>(
  async (fastify, { client }) => {
    await fastify.register(fastifyRedis, redisOptions(fastify.config, client));

    // Rejecting is how `/readyz` learns Redis is unreachable. Nothing else is gated on it.
    fastify.addHealthCheck("redis", () => fastify.redis.ping());
  },
  { name: "redis" },
);
