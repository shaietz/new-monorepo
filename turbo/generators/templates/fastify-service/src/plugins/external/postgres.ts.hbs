import fastifyPostgres from "@fastify/postgres";
import fp from "fastify-plugin";
import type * as Pg from "pg";
import type { PostgresPluginOptions } from "@fastify/postgres";

/**
 * The `pg` module itself. Imported by name rather than pulled off the plugin's options so `pg`
 * stays a visible dependency — nothing else here references it, and knip would call it unused.
 */
export type PgModule = typeof Pg;

export interface PostgresPluginParams {
  /** A stand-in `pg` module, so a test suite needs no database. */
  readonly pg?: PgModule | undefined;
}

export function postgresOptions(
  config: { DATABASE_URL: string; PG_POOL_MAX: number },
  pgModule?: PgModule,
): PostgresPluginOptions {
  const options: PostgresPluginOptions = {
    connectionString: config.DATABASE_URL,
    max: config.PG_POOL_MAX,
    // pg waits forever by default, and a probe that never settles reads as healthy.
    connectionTimeoutMillis: 2000,
  };

  // Injected in tests so the suite needs no database; production takes the pool pg builds itself.
  if (pgModule) return { ...options, pg: pgModule };

  return options;
}

/** @see {@link https://github.com/fastify/fastify-postgres} */
export default fp<PostgresPluginParams>(
  async (fastify, { pg }) => {
    await fastify.register(fastifyPostgres, postgresOptions(fastify.config, pg));

    // Rejecting is how `/readyz` learns Postgres is unreachable. Nothing else is gated on it.
    fastify.addHealthCheck("postgres", () => fastify.pg.query("SELECT 1"));
  },
  { name: "postgres" },
);
