import { drizzle } from "drizzle-orm/node-postgres";
import fp from "fastify-plugin";
import { Pool } from "pg";
import * as schema from "../../db/schemas/index.ts";
import type { NodePgDatabase } from "drizzle-orm/node-postgres";
import type { PoolConfig } from "pg";

export type { Pool } from "pg";

export type Database = NodePgDatabase<typeof schema> & { $client: Pool };

declare module "fastify" {
  interface FastifyInstance {
    readonly db: Database;
  }
}

export interface PostgresPluginParams {
  /** A stand-in pool, so a test suite needs no database. */
  readonly pool?: Pool | undefined;
}

export function poolOptions(config: { DATABASE_URL: string; PG_POOL_MAX: number }): PoolConfig {
  return {
    connectionString: config.DATABASE_URL,
    max: config.PG_POOL_MAX,
    // pg waits forever by default, and a probe that never settles reads as healthy.
    connectionTimeoutMillis: 2000,
  };
}

export default fp<PostgresPluginParams>(
  async (fastify, { pool }) => {
    const client = pool ?? new Pool(poolOptions(fastify.config));

    fastify.decorate("db", drizzle(client, { schema, casing: "snake_case" }));
    fastify.addHook("onClose", () => client.end());
    fastify.addHealthCheck("postgres", () => client.query("SELECT 1"));
  },
  { name: "postgres" },
);
