{{#if postgres}}
import fastifyPostgres from "@fastify/postgres";
{{/if}}
{{#if redis}}
import fastifyRedis from "@fastify/redis";
{{/if}}
import fastify from "fastify";
import { basePlugin, loadConfig, serverOptions } from "@repo/fastify-base";
{{#if hasDataStore}}
import { z } from "zod";
{{/if}}
{{#if postgres}}
import { checkPostgres, postgresOptions } from "./postgres.ts";
{{/if}}
{{#if redis}}
import { checkRedis, redisOptions } from "./redis.ts";
{{/if}}
{{#if postgres}}
import type { PgModule } from "./postgres.ts";
{{/if}}
{{#if redis}}
import type { RedisClient } from "./redis.ts";
{{/if}}

const SERVICE_NAME = "{{ dashCase name }}";

{{#if hasDataStore}}
// No defaults: a service deployed without these should fail at boot, not quietly dial localhost.
export const config = loadConfig({
{{#if postgres}}
  DATABASE_URL: z.url(),
  PG_POOL_MAX: z.coerce.number().min(1).default(10),
{{/if}}
{{#if redis}}
  REDIS_URL: z.url(),
{{/if}}
});

/** Clients standing in for the ones `config` would otherwise dial. Tests inject through here. */
export interface ServerOverrides {
{{#if postgres}}
  postgres?: PgModule;
{{/if}}
{{#if redis}}
  redis?: RedisClient;
{{/if}}
}

/** Both arguments exist for tests; production takes the defaults. */
export async function buildServer(overrides: ServerOverrides = {}, cfg: typeof config = config) {
{{else}}
export const config = loadConfig();

/** `cfg` is a parameter so tests can build a server without stubbing the environment first. */
export async function buildServer(cfg: typeof config = config) {
{{/if}}
  const server = fastify(serverOptions(cfg, SERVICE_NAME));

{{#if hasDataStore}}
  // Before basePlugin, so the clients are decorated on `server` by the time /readyz probes them.
{{/if}}
{{#if redis}}
  await server.register(fastifyRedis, redisOptions(cfg, overrides.redis));
{{/if}}
{{#if postgres}}
  await server.register(fastifyPostgres, postgresOptions(cfg, overrides.postgres));
{{/if}}
{{#if hasDataStore}}

  await server.register(basePlugin, {
    config: cfg,
    name: SERVICE_NAME,
{{#if redis}}
{{#if postgres}}
    healthCheck: async () => {
      await Promise.all([checkRedis(server), checkPostgres(server)]);
    },
{{else}}
    healthCheck: () => checkRedis(server),
{{/if}}
{{else}}
    healthCheck: () => checkPostgres(server),
{{/if}}
  });
{{else}}
  await server.register(basePlugin, { config: cfg, name: SERVICE_NAME });
{{/if}}

  server.get("/ping", async () => {
    return "pong\n";
  });

  return server;
}
