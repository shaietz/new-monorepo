import { join } from "node:path";
import autoload from "@fastify/autoload";
import fp from "fastify-plugin";
{{#if hasDataStore}}
import { z } from "zod";
{{/if}}
import { basePlugin, loadConfig, serverOptions } from "@repo/fastify-base";
{{#if postgres}}
import postgresPlugin from "./plugins/external/postgres.ts";
import type { PgModule } from "./plugins/external/postgres.ts";
{{/if}}
{{#if redis}}
import redisPlugin from "./plugins/external/redis.ts";
import type { RedisClient } from "./plugins/external/redis.ts";
{{/if}}
import trpcPlugin from "./plugins/external/trpc.ts";
import type { AppRouter } from "./plugins/external/trpc.ts";
import { appRouter } from "./router/index.ts";

const NAME = "{{ dashCase name }}";

{{#if hasDataStore}}
// No defaults: a service deployed without these should fail at boot, not quietly dial localhost.
const extraEnv = {
{{#if postgres}}
  DATABASE_URL: z.url(),
  PG_POOL_MAX: z.coerce.number().min(1).default(10),
{{/if}}
{{#if redis}}
  REDIS_URL: z.url(),
{{/if}}
};

export const config = loadConfig(extraEnv);

// Merges this service's variables into `fastify.config`, derived from the schema above so the
// runtime shape and the type cannot drift.
declare module "fastify" {
  interface FastifyConfig extends z.infer<z.ZodObject<typeof extraEnv>> {}
}
{{else}}
export const config = loadConfig();
{{/if}}

/** Stand-in clients a test can substitute; production registers the real ones. */
export interface AppOptions {
  readonly trpcRouter?: AppRouter | undefined;
{{#if postgres}}
  readonly pg?: PgModule | undefined;
{{/if}}
{{#if redis}}
  readonly redisClient?: RedisClient | undefined;
{{/if}}
}

export const options = serverOptions(config, NAME);

/**
 * `fp` so the error handler, schema compilers and decorators inside `basePlugin` apply to the root
 * instance rather than a throwaway child scope.
 *
 * `basePlugin` is the shared stack — config, Zod, security middleware, health probes, metrics,
 * OpenAPI, the error handler. To change one of those, replace this line with the individual plugins
 * it registers; see `@repo/fastify-base`'s README.
 */
export default fp<AppOptions>(
  async function app(fastify, opts) {
    await fastify.register(basePlugin, { config, name: NAME });

{{#if postgres}}
    await fastify.register(postgresPlugin, { pg: opts.pg });
{{/if}}
{{#if redis}}
    await fastify.register(redisPlugin, { client: opts.redisClient });
{{/if}}
    // Prefer an injected router for tests; fall back to the generated `appRouter` for the
    // real service.
    await fastify.register(trpcPlugin, { router: opts.trpcRouter ?? appRouter });
    await fastify.register(autoload, {
      dir: join(import.meta.dirname, "routes"),
      // Required: autoload reads `options.prefix` unguarded when a plugin exports `autoConfig` as a
      // function, and throws on `undefined`.
      options: {},
      autoHooks: true,
      cascadeHooks: true,
    });
  },
  { name: `${NAME}-app` },
);
