import { afterEach, describe, expect, it } from "vitest";
import type { FastifyInstance } from "fastify";
import { buildServer } from "./app.ts";
{{#if hasDataStore}}
import type { ServerOverrides } from "./app.ts";
{{/if}}
{{#if postgres}}
import type { PgModule } from "./postgres.ts";
{{/if}}
{{#if redis}}
import type { RedisClient } from "./redis.ts";
{{/if}}

const started: FastifyInstance[] = [];

afterEach(async () => {
  await Promise.all(started.splice(0).map((server) => server.close()));
});

{{#if redis}}
/** A client already reporting "ready" is one `@fastify/redis` registers without connecting. */
function redisStub(ping: () => Promise<string>): RedisClient {
  return { status: "ready", ping, quit: async () => "OK" } as unknown as RedisClient;
}

{{/if}}
{{#if postgres}}
/** `@fastify/postgres` only does `new pg.Pool(options)`, so a stand-in module is enough. */
function postgresStub(query: () => Promise<unknown>): PgModule {
  class Pool {
    query = query;
    connect = async () => ({ query, release: () => {} });
    end = (done?: () => void) => {
      done?.();
      return Promise.resolve();
    };
  }

  return { Pool } as unknown as PgModule;
}

{{/if}}
{{#if hasDataStore}}
/** Healthy stand-ins, so the suite needs nothing running, unless a test overrides one. */
async function build(overrides: ServerOverrides = {}) {
  const server = await buildServer({
{{#if redis}}
    redis: redisStub(async () => "PONG"),
{{/if}}
{{#if postgres}}
    postgres: postgresStub(async () => ({ rows: [] })),
{{/if}}
    ...overrides,
  });

  started.push(server);
  return server;
}
{{else}}
async function build() {
  const server = await buildServer();
  started.push(server);
  return server;
}
{{/if}}

describe("GET /ping", () => {
  it("returns pong", async () => {
    const server = await build();
    const res = await server.inject({ method: "GET", url: "/ping" });

    expect(res.statusCode).toBe(200);
    expect(res.body).toBe("pong\n");
  });
});

describe("request ids", () => {
  /** `req.id` isn't visible on a normal response, so expose it for the assertion. */
  async function buildWithProbe() {
    const server = await build();
    server.get("/whoami", async (req) => ({ id: req.id }));
    return server;
  }

  it("propagates an upstream request id", async () => {
    const server = await buildWithProbe();
    const res = await server.inject({
      url: "/whoami",
      headers: { "x-request-id": "upstream-123" },
    });

    expect(res.json()).toEqual({ id: "upstream-123" });
  });

  it("takes the first value when x-request-id is repeated", async () => {
    // Node joins duplicate headers into "first,second" before Fastify sees them.
    const server = await buildWithProbe();
    const res = await server.inject({
      url: "/whoami",
      headers: { "x-request-id": ["first", "second"] },
    });

    expect(res.json()).toEqual({ id: "first" });
  });

  it("generates an id when the header is absent", async () => {
    const server = await buildWithProbe();
    const res = await server.inject({ url: "/whoami" });

    expect(res.json().id).toMatch(/^[0-9a-f-]{36}$/);
  });

  it("generates an id when the header is empty", async () => {
    const server = await buildWithProbe();
    const res = await server.inject({ url: "/whoami", headers: { "x-request-id": "  " } });

    expect(res.json().id).toMatch(/^[0-9a-f-]{36}$/);
  });
});
{{#if hasDataStore}}

describe("GET /readyz", () => {
  it("is ready while the data stores answer", async () => {
    const server = await build();

    expect((await server.inject({ url: "/readyz" })).statusCode).toBe(200);
  });
{{#if redis}}

  it("is unavailable when Redis stops answering", async () => {
    const server = await build({
      redis: redisStub(async () => {
        throw new Error("connection refused");
      }),
    });

    expect((await server.inject({ url: "/readyz" })).statusCode).toBe(503);
    // Only readiness is affected — nothing sheds ordinary traffic.
    expect((await server.inject({ url: "/ping" })).statusCode).toBe(200);
  });
{{/if}}
{{#if postgres}}

  it("is unavailable when Postgres stops answering", async () => {
    const server = await build({
      postgres: postgresStub(async () => {
        throw new Error("connection refused");
      }),
    });

    expect((await server.inject({ url: "/readyz" })).statusCode).toBe(503);
    expect((await server.inject({ url: "/ping" })).statusCode).toBe(200);
  });
{{/if}}
});
{{/if}}
