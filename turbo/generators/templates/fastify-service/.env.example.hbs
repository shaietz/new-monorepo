NODE_ENV=development
HOST=0.0.0.0
PORT={{ port }}
LOG_LEVEL=info
SHUTDOWN_GRACE_MS=10000
HEALTH_TIMEOUT_MS=2000
TRUST_PROXY=false
CORS_ORIGIN=
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
BODY_LIMIT=1048576
ENABLE_DOCS=false
{{#if redis}}
REDIS_URL=redis://localhost:6379
{{/if}}
{{#if postgres}}
DATABASE_URL=postgres://localhost/{{ dashCase name }}
PG_POOL_MAX=10
{{/if}}
