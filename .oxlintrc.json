{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "eqeqeq": ["error", "always"],
    "no-console": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "import/no-cycle": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "@testing-library/**"] }],
    "unicorn/prefer-node-protocol": "error",
    "node/no-sync": "warn",
    "oxc/no-async-endpoint-handlers": "off"
  },
  "overrides": [
    {
      "files": ["**/*.{jsx,tsx}", "**/use*.{ts,tsx}"],
      "plugins": ["react", "jsx-a11y"],
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "react/only-export-components": ["warn", { "allowConstantExport": true }]
      }
    },
    {
      "files": ["**/*.{test,spec}.{ts,tsx}"],
      "plugins": ["vitest"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "no-console": "off",
        "vitest/no-focused-tests": "error",
        "vitest/no-identical-title": "error",
        "vitest/expect-expect": "error",
        "vitest/no-disabled-tests": "warn"
      }
    },
    {
      "files": ["**/*.config.{ts,js,mts,mjs}"],
      "rules": { "no-console": "off" }
    },
    {
      "files": ["scripts/**"],
      "rules": { "no-console": "off", "no-underscore-dangle": "off", "node/no-sync": "off" }
    }
  ]
}
