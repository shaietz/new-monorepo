{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "boundaries": {
    "tags": {
      "app": {
        "dependents": {
          "allow": []
        }
      },
      "browser": {
        "dependencies": {
          "deny": ["node"]
        }
      },
      "node": {
        "dependencies": {
          "deny": ["browser"]
        }
      },
      "isomorphic": {
        "dependencies": {
          "deny": ["node", "browser"]
        }
      }
    }
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "//#quality": {
      "dependsOn": ["//#lint", "//#format"]
    },
    "//#quality:fix": {
      "dependsOn": ["//#lint:fix", "//#format:fix"]
    },
    "//#lint": {
      "inputs": ["**/*.{ts,tsx,js,jsx,mjs}", ".oxlintrc.json"],
      "outputs": []
    },
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "//#syncpack": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
